// NOHO Tunisia — data model.
// Greenfield DB, separate from noho-mailbox (its own Turso instance).
// Provider is sqlite (libSQL via the Prisma driver adapter; see src/lib/prisma.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  // Runtime connects via the libSQL driver adapter (src/lib/prisma.ts); the
  // schema/seed is applied by scripts/push-init.ts (raw libSQL), not the CLI.
}

/// Staff + partners. role: "ADMIN" | "EMPLOYEE" | "PARTNER" (mirrors src/components/admin/roles.ts).
model User {
  id           String          @id @default(cuid())
  name         String
  email        String          @unique
  passwordHash String
  role         String          @default("EMPLOYEE")
  active       Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  codes        AffiliateCode[]
}

/// Affiliate referral codes generated by partners.
model AffiliateCode {
  id        String     @id @default(cuid())
  code      String     @unique
  label     String     @default("Code général")
  ownerId   String
  owner     User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  clicks    Int        @default(0)
  signups   Int        @default(0)
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  referrals Referral[]

  @@index([ownerId])
}

/// Individual referral events for a code ("click" | "signup").
model Referral {
  id        String        @id @default(cuid())
  codeId    String
  code      AffiliateCode @relation(fields: [codeId], references: [id], onDelete: Cascade)
  kind      String
  createdAt DateTime      @default(now())

  @@index([codeId])
}

/// Business consultation leads from the /business form ("on te recontacte").
/// status: "NEW" | "HANDLED".
model ConsultationRequest {
  id        String   @id @default(cuid())
  email     String
  firstName String
  lastName  String
  reason    String
  locale    String   @default("fr")
  status    String   @default("NEW")
  createdAt DateTime @default(now())

  @@index([status, createdAt])
}

/// Shipping-label orders from the public /shipping generator.
/// status: "PENDING_PAYMENT" | "PAID" | "LABELED" | "CANCELLED".
/// Payment happens offline in dinars (wallet / Cabinet Khiari) — never in-app.
model LabelOrder {
  id               String   @id @default(cuid())
  email            String
  phone            String   @default("")
  suite            String   @default("")
  toName           String
  toStreet1        String
  toCity           String
  toState          String   @default("")
  toZip            String   @default("")
  toCountry        String
  lengthIn         Float
  widthIn          Float
  heightIn         Float
  weightLb         Float
  provider         String
  servicelevel     String
  amountUsd        Float
  amountTnd        Int
  rateObjectId     String
  shipmentObjectId String
  status           String   @default("PENDING_PAYMENT")
  labelUrl         String   @default("")
  trackingNumber   String   @default("")
  trackingUrl      String   @default("")
  locale           String   @default("fr")
  createdAt        DateTime @default(now())

  @@index([status, createdAt])
}
